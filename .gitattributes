# LF everywhere, so hooks, scripts and builds behave the same on Windows (core.autocrlf=true) and Linux.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.mp3 binary
*.wav binary
*.ogg binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.docx binary
*.pdf binary
